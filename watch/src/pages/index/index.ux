<template>
  <div class="page">
    <div class="remote" if="{{!toolsOpen}}">
      <div class="status-strip">
        <div class="status-item status-phone" onclick="openTools"><image class="status-icon" src="{{phoneIcon}}"></image></div>
        <div class="status-item status-camera" onclick="openTools"><image class="status-icon" src="{{cameraIcon}}"></image></div>
        <div class="status-item status-gps" onclick="openTools"><image class="status-icon" src="{{gpsIcon}}"></image></div>
        <div class="status-item status-battery" onclick="openTools"><image class="status-icon" src="{{batteryIcon}}"></image></div>
      </div>
      <div class="storage-badge"><image class="status-icon" src="/common/ui/sd-card.png"></image><text class="storage-value">{{remainingText}}</text></div>
      <div class="temperature-badge"><image class="status-icon" src="{{temperatureIcon}}"></image><text class="temperature-value">{{temperatureText}}</text></div>
      <div class="{{captureClass}}" ontouchstart="startCapturePress" ontouchend="endCapturePress" ontouchcancel="endCapturePress">
        <image class="{{captureImageClass}}" src="{{captureIcon}}"></image>
        <progress if="{{pressRingVisible}}" class="capture-progress" type="arc" percent="{{pressProgress}}"></progress>
      </div>
      <text class="{{timerClass}}">{{timerText}}</text>
      <text class="format-summary">{{videoFormatText}}</text>
    </div>
    <div class="tools" if="{{toolsOpen}}">
      <text class="tools-title">连接</text>
      <div class="tools-row" onclick="checkRelay"><image class="row-icon" src="{{phoneIcon}}"></image><text class="row-text">{{phoneText}}</text></div>
      <div class="tools-row"><image class="row-icon" src="{{cameraIcon}}"></image><text class="row-text">{{cameraText}}</text></div>
      <div class="tools-row feedback-row" onclick="toggleFeedback"><text class="feedback-mark">振</text><text class="row-text">{{feedbackText}}</text></div>
      <text class="tools-note">{{noteText}}</text>
      <div class="refresh-button" onclick="refreshStatus"><image class="row-icon" src="/common/ui/refresh.png"></image><text class="refresh-label">刷新状态</text></div>
      <div class="back-button" onclick="closeTools"><image class="row-icon" src="/common/ui/back.png"></image><text class="back-label">返回</text></div>
    </div>
  </div>
</template>

<script>
import { createRelayController } from '../../common/relayController.js'
import { createHoldProgress } from '../../common/holdProgress.js'
import { remainingLabel, videoLabel, temperatureLabel, temperatureIcon } from '../../common/cameraDisplay.js'

export default {
  private: {
    toolsOpen: false,
    phoneText: '中转：未连接',
    cameraText: '相机：未连接',
    noteText: '请开启中转设备',
    phoneIcon: '/common/ui/phone-off.png',
    cameraIcon: '/common/ui/camera-off.png',
    gpsIcon: '/common/ui/gps-off.png',
    batteryIcon: '/common/ui/battery-off.png',
    timerText: '--:--',
    timerClass: 'timer',
    remainingText: '—',
    temperatureText: '—',
    temperatureIcon: '/common/ui/temperature-off.png',
    videoFormatText: '—',
    captureIcon: '/common/ui/refresh.png',
    captureClass: 'capture capture-reconnect',
    captureImageClass: 'capture-image capture-refresh',
    refreshMode: true,
    photoEnabled: false,
    startEnabled: false,
    stopEnabled: false,
    pressProgress: 0,
    pressRingVisible: false,
    feedbackEnabled: true,
    feedbackText: '录制反馈：开启'
  },
  onInit() {
    this._storage = require('@system.storage')
    this._vibrator = require('@system.vibrator')
    this.loadFeedbackSetting()
    this._hold = createHoldProgress({
      now: function () { return Date.now() },
      setTimer: function (fn, ms) { return setTimeout(fn, ms) },
      clearTimer: function (id) { clearTimeout(id) },
      canStop: () => this.stopEnabled && !!this._relay,
      onStop: () => this._relay.command('stop'),
      onProgress: (value, visible) => { this.pressProgress = value; this.pressRingVisible = visible }
    })
    this._relay = createRelayController({
      loadConnection: function () {
        var interconnect = require('@system.interconnect')
        return interconnect.instance()
      },
      now: function () { return Date.now() },
      setTimer: function (fn, ms) { return setTimeout(fn, ms) },
      clearTimer: function (id) { clearTimeout(id) },
      onState: (state) => { this.applyState(state) }
    })
    this._relay.show()
  },
  applyState(state) {
    this.phoneText = state.phoneText || '中转：未连接'
    if (state.relayKind === 'nrf52840' && state.relayLatencyMs >= 0) this.phoneText += ' ' + Math.floor(state.relayLatencyMs) + 'ms'
    this.cameraText = state.cameraText || '相机：未连接'
    this.noteText = state.noteText || '状态以相机回报为准'
    this.photoEnabled = state.photoEnabled === true
    this.startEnabled = state.startEnabled === true
    this.stopEnabled = state.stopEnabled === true
    this.remainingText = remainingLabel(state.remainingSeconds)
    this.temperatureText = temperatureLabel(state.temperatureState)
    this.temperatureIcon = temperatureIcon(state.temperatureState)
    this.videoFormatText = videoLabel(state.cameraMode, state.videoResolution, state.fpsIndex)
    var phone = state.phoneConnected === true
    var camera = state.cameraReady === true
    var recording = state.recording === true
    var phase = state.recordPhase || 'unknown'
    var pending = state.pending === true || phase === 'starting' || phase === 'stopping' || phase === 'switching' || phase === 'capturing'
    this.refreshMode = (!phone || !camera) && !pending
    this.captureClass = this.refreshMode ? 'capture capture-reconnect' : 'capture'
    this.captureImageClass = this.refreshMode ? 'capture-image capture-refresh' : 'capture-image'
    this.phoneIcon = '/common/ui/' + (state.relayKind === 'nrf52840' ? 'board-' : 'phone-') + ((state.relayConnected === undefined ? phone : state.relayConnected) ? 'on' : 'off') + '.png'
    this.cameraIcon = '/common/ui/camera-' + (camera ? 'on' : 'off') + '.png'
    this.batteryIcon = '/common/ui/battery-' + (typeof state.battery === 'number' && state.battery >= 0 ? (state.battery <= 20 ? 'low' : state.battery <= 50 ? 'medium' : 'high') : 'off') + '.png'
    var gps = state.gpsState || 'off'
    this.gpsIcon = '/common/ui/gps-' + (!state.gpsEnabled ? 'off' : gps === 'ready' ? 'on' : gps === 'denied' || gps === 'provider_off' || gps === 'unavailable' ? 'error' : 'wait') + '.png'
    var seconds = typeof state.recordSeconds === 'number' && state.recordSeconds >= 0 ? Math.floor(state.recordSeconds) : 0
    this.timerText = state.cameraMode === 5 ? (pending ? '拍摄中' : '拍照') : !camera || phase === 'unknown' ? '--:--' : this.timeText(recording ? seconds : 0)
    this.timerClass = recording ? 'timer timer-recording' : 'timer'
    if (this.refreshMode) this.captureIcon = '/common/ui/refresh.png'
    else if (this.stopEnabled) this.captureIcon = '/common/ui/capture-stop.png'
    else if (this.photoEnabled) this.captureIcon = '/common/ui/capture-photo.png'
    else if (this.startEnabled) this.captureIcon = '/common/ui/capture-record.png'
    else this.captureIcon = '/common/ui/capture-' + (pending ? 'pending' : 'disabled') + '.png'
  },
  timeText(seconds) {
    var minutes = Math.floor(seconds / 60)
    var remainder = seconds % 60
    return (minutes < 10 ? '0' : '') + minutes + ':' + (remainder < 10 ? '0' : '') + remainder
  },
  onShow() { if (this._relay) this._relay.show() },
  onHide() { if (this._hold) this._hold.cancel(); if (this._relay) this._relay.hide() },
  onDestroy() { if (this._hold) this._hold.cancel(); if (this._relay) this._relay.destroy(); this._relay = null },
  loadFeedbackSetting() {
    this._storage.get({
      key: 'capture_feedback_enabled',
      default: '1',
      success: (value) => {
        this.feedbackEnabled = value !== '0'
        this.feedbackText = '录制反馈：' + (this.feedbackEnabled ? '开启' : '关闭')
      }
    })
  },
  toggleFeedback() {
    this.feedbackEnabled = !this.feedbackEnabled
    this.feedbackText = '录制反馈：' + (this.feedbackEnabled ? '开启' : '关闭')
    this._storage.set({
      key: 'capture_feedback_enabled',
      value: this.feedbackEnabled ? '1' : '0'
    })
  },
  playFeedback(mode) {
    if (this.feedbackEnabled && this._vibrator) this._vibrator.vibrate({ mode: mode })
  },
  startCapturePress() {
    if (this.refreshMode) { this.refreshStatus(); return }
    if (this.stopEnabled) {
      if (this._hold && this._hold.start()) this.playFeedback('long')
    } else if (this.photoEnabled && this._relay) {
      this.playFeedback('short')
      this._relay.command('photo')
    } else if (this.startEnabled && this._relay) {
      this.playFeedback('short')
      this._relay.command('start')
    }
  },
  endCapturePress() { if (this._hold) this._hold.release() },
  checkRelay() { if (this._relay) this._relay.ping() },
  openTools() { if (this._hold) this._hold.cancel(); this.toolsOpen = true; this.checkRelay() },
  closeTools() { this.toolsOpen = false },
  refreshStatus() { if (this._relay) this._relay.refresh() }
}
</script>

<style>
.page { width: 466px; height: 466px; background-color: #000000; }
.remote { width: 466px; height: 466px; background-color: #000000; }
.status-strip { position: absolute; left: 0px; top: 0px; width: 466px; height: 150px; }
.status-item { position: absolute; width: 56px; height: 56px; align-items: center; justify-content: center; }
.status-phone { left: 74px; top: 87px; }
.status-camera { left: 157px; top: 36px; }
.status-gps { left: 253px; top: 36px; }
.status-battery { left: 336px; top: 87px; }
.status-icon { width: 44px; height: 44px; }
.timer { position: absolute; left: 145px; top: 354px; width: 176px; height: 44px; text-align: center; font-size: 36px; color: #f1f3f6; }
.timer-recording { color: #ff6165; }
.capture { position: absolute; left: 121px; top: 121px; width: 224px; height: 224px; align-items: center; justify-content: center; }
.capture-reconnect { border-radius: 112px; }
.capture-image { width: 192px; height: 192px; }
.capture-refresh { width: 96px; height: 96px; }
.capture-progress { position: absolute; left: 0px; top: 0px; width: 224px; height: 224px; color: #ff304d; layer-color: #e4e8ed; stroke-width: 12px; start-angle: 0deg; total-angle: 360deg; center-x: 112px; center-y: 112px; radius: 90px; }
.format-summary { position: absolute; left: 153px; top: 402px; width: 160px; height: 32px; text-align: center; font-size: 24px; color: #cbd3df; }
.storage-badge { position: absolute; left: 14px; top: 211px; width: 104px; height: 69px; flex-direction: column; align-items: center; justify-content: center; }
.temperature-badge { position: absolute; left: 348px; top: 211px; width: 104px; height: 69px; flex-direction: column; align-items: center; justify-content: center; }
.temperature-value { width: 104px; height: 25px; text-align: center; font-size: 19px; color: #f1f3f6; }
.storage-value { width: 104px; height: 25px; text-align: center; font-size: 17px; color: #f1f3f6; }
.tools { width: 466px; height: 466px; background-color: #000000; flex-direction: column; align-items: center; padding-top: 38px; }
.tools-title { width: 270px; height: 46px; text-align: center; font-size: 27px; color: #f1f3f6; }
.tools-row { width: 290px; height: 48px; flex-direction: row; align-items: center; }
.row-icon { width: 27px; height: 27px; margin-right: 13px; }
.feedback-mark { width: 27px; height: 27px; margin-right: 13px; text-align: center; font-size: 19px; color: #6ad9a4; }
.row-text { width: 245px; font-size: 20px; color: #cbd3df; }
.tools-note { width: 292px; height: 74px; font-size: 18px; color: #a6b0bf; lines: 3; margin-top: 10px; }
.refresh-button { width: 280px; height: 64px; border-radius: 24px; background-color: #202630; flex-direction: row; align-items: center; justify-content: center; margin-top: 8px; }
.refresh-label { font-size: 22px; color: #e9edf4; }
.back-button { width: 202px; height: 62px; border-radius: 25px; background-color: #171b22; flex-direction: row; align-items: center; justify-content: center; margin-top: 12px; }
.back-label { font-size: 21px; color: #b9c5d5; }
</style>
